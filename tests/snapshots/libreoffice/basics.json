    {"kind": "paragraph", "level": 0, "list": "", "text": "“Goods” means the products listed in Schedule A. “Delivery Date” means the date stated in a purchase order, or ten business days after the order if no date is stated.", "runs": [{"text": "“Goods” means the products listed in Schedule A. “Delivery Date” means the date stated in a purchase order, or ", "bold": false, "italic": false, "underline": false, "strike": false, "superscript": false, "subscript": false, "link": ""}, {"text": "ten business days", "bold": true, "italic": false, "underline": false, "strike": false, "superscript": false, "subscript": false, "link": ""}, {"text": " after the order if no date is stated.", "bold": false, "italic": false, "underline": false, "strike": false, "superscript": false, "subscript": false, "link": ""}], "rows": []},
    {"kind": "heading", "level": 2, "list": "", "text": "2. Supply", "runs": [{"text": "2. Supply", "bold": false, "italic": false, "underline": false, "strike": false, "superscript": false, "subscript": false, "link": ""}], "rows": []},
