    {"kind": "paragraph", "level": 0, "list": "", "text": "This agreement is made between Northwind Traders (“Supplier”) and Contoso Pty Ltd (“Customer”) on the date of the last signature below.", "runs": [{"text": "This agreement is made between Northwind Traders (“Supplier”) and Contoso Pty Ltd (“Customer”) on the date of the last signature below.", "bold": false, "italic": false, "underline": false, "strike": false, "superscript": false, "subscript": false, "link": ""}], "rows": []},
